<?xml version="1.0"?>
<package format="3">
  <name>as2_a8_tracker</name><version>0.1.0</version>
  <description>SIYI A8 mini person detection and gimbal tracking (multilock1 tracker) with ROS 2 bridge and SITL camera simulator.</description>
  <maintainer email="maintainer@example.com">AS2 rescue project</maintainer>
  <license>BSD-3-Clause</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend><exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend><exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend><exec_depend>ament_index_python</exec_depend>
  <exec_depend>python3-numpy</exec_depend><exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-psutil</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
