<?xml version='1.0' encoding='utf-8'?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="rescue_arena_300">
  <!--Rebuild placements from config/arena.json with generate_arena.py.-->
  <xacro:macro name="arena_box" params="name xyz rpy rgba collision size">
    <visual name="${name}">
      <origin xyz="${xyz}" rpy="${rpy}" />
      <geometry>
        <box size="${size}" />
      </geometry>
      <material name="${name}_material">
        <color rgba="${rgba}" />
      </material>
    </visual>
    <xacro:if value="${collision}">
      <collision name="${name}_collision">
        <origin xyz="${xyz}" rpy="${rpy}" />
        <geometry>
          <box size="${size}" />
        </geometry>
      </collision>
    </xacro:if>
  </xacro:macro>
  <xacro:macro name="arena_sphere" params="name xyz rpy rgba collision radius">
    <visual name="${name}">
      <origin xyz="${xyz}" rpy="${rpy}" />
      <geometry>
        <sphere radius="${radius}" />
      </geometry>
      <material name="${name}_material">
        <color rgba="${rgba}" />
      </material>
    </visual>
    <xacro:if value="${collision}">
      <collision name="${name}_collision">
        <origin xyz="${xyz}" rpy="${rpy}" />
        <geometry>
          <sphere radius="${radius}" />
        </geometry>
      </collision>
    </xacro:if>
  </xacro:macro>
  <xacro:macro name="arena_cylinder" params="name xyz rpy rgba collision radius length">
    <visual name="${name}">
      <origin xyz="${xyz}" rpy="${rpy}" />
      <geometry>
        <cylinder radius="${radius}" length="${length}" />
      </geometry>
      <material name="${name}_material">
        <color rgba="${rgba}" />
      </material>
    </visual>
    <xacro:if value="${collision}">
      <collision name="${name}_collision">
        <origin xyz="${xyz}" rpy="${rpy}" />
        <geometry>
          <cylinder radius="${radius}" length="${length}" />
        </geometry>
      </collision>
    </xacro:if>
  </xacro:macro>
  <link name="world" />
  <gazebo>
    <static>true</static>
  </gazebo>
  <link name="ground">
    <inertial>
      <mass value="1" />
      <inertia ixx="1" iyy="1" izz="1" ixy="0" ixz="0" iyz="0" />
    </inertial>
    <xacro:arena_box name="ground_surface" xyz="0 0 -0.25" rpy="0 0 0" rgba="0.4 0.47 0.29 1" collision="true" size="300 300 0.5" />
  </link>
  <joint name="ground_fixed" type="fixed">
    <parent link="world" />
    <child link="ground" />
    <origin xyz="0 0 0" rpy="0 0 0" />
  </joint>
