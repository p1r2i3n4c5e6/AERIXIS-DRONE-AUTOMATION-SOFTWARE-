# /etc/default/as2-rescue — read by every as2-* unit. Settings for the links themselves live in
# ~/.config/as2/pi_launcher.json (Pi GUI) and can be overridden here as AS2_<KEY>=value.
#
# Optional, NOT yet verified with the XRCE agent (it uses Fast-DDS directly, not the ROS
# middleware setting): keep ROS traffic on the Pi for faster discovery and no ROS chatter on
# the camera/Wi-Fi network. Enable only after checking 'fc_guardian/state' shows px4.fresh=true.
# ROS_LOCALHOST_ONLY=1
# AS2_EMERGENCY_ACTION=RTL
# AS2_GUARDIAN_TIMEOUT=3.0
# AS2_CAMERA_MODE=off
