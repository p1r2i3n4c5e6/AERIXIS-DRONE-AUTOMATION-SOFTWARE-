<root BTCPP_format="4" main_tree_to_execute="Mission">
  <BehaviorTree ID="Mission">
    <RecoverThenFail>
      <Sequence>
        <Timeout msec="10000">
          <RetryUntilSuccessful num_attempts="-1">
            <Delay delay_msec="100">
              <VehicleHealthy />
            </Delay>
          </RetryUntilSuccessful>
        </Timeout>
        <SafetyGate flag="VehicleHealthy">
          <Sequence name="FlightLifecycle">
            <Offboard service_name="set_offboard_mode" />
            <Arm service_name="set_arming_state" />
            <ManagedTakeoff height="5" speed="0.5" />
            <ReactiveFallback>
              <Sequence>
                <RescuePending />
                <ForceFailure>
                  <Fallback>
                    <Sequence name="RescueResponse">
                      <CheckpointCoverage />
                      <PauseCoverage />
                      <ConfirmHold />
                      <Timeout msec="10000">
                        <TrackPerson timeout_s="9" />
                      </Timeout>
                      <GeotagTarget />
                      <AcquireAssignment swarm_id="shared-mission-group" />
                      <ApproachDeliveryZone swarm_id="shared-mission-group" timeout_s="60" />
                      <PauseCoverage />
                      <ConfirmHold />
                      <VerifyDeliveryZone />
                      <Timeout msec="8000">
                        <RetryUntilSuccessful num_attempts="-1">
                          <Delay delay_msec="100">
                            <StableFor seconds="2">
                              <SafeToRelease />
                            </StableFor>
                          </Delay>
                        </RetryUntilSuccessful>
                      </Timeout>
                      <ReleasePayload timeout_s="5" />
                      <VerifyPayloadRelease />
                      <ReleaseAssignment swarm_id="shared-mission-group" />
                      <ReportObservation />
                      <ResumeCoverage timeout_s="60" />
                      <CompleteRescue />
                    </Sequence>
                    <Sequence name="ObservationRecovery">
                      <PauseCoverage />
                      <ConfirmHold />
                      <ReportObservation />
                      <ResumeCoverage timeout_s="60" />
                      <CompleteRescue />
                    </Sequence>
                  </Fallback>
                </ForceFailure>
              </Sequence>
              <SafetyGate flag="SeparationSafe">
                <SafetyGate flag="PeersFresh">
                  <Sequence name="CheckpointedCoverage">
                    <SurveyWaypoint segment_id="leg_0" pose="0;0;5" speed="0.5" timeout_s="120" swarm_id="shared-mission-group" />
                    <SurveyWaypoint segment_id="leg_1" pose="10;0;5" speed="0.5" timeout_s="120" swarm_id="shared-mission-group" />
                    <SurveyWaypoint segment_id="leg_2" pose="10;10;5" speed="0.5" timeout_s="120" swarm_id="shared-mission-group" />
                  </Sequence>
                </SafetyGate>
              </SafetyGate>
            </ReactiveFallback>
            <ManagedLand speed="0.5" />
            <Disarm service_name="set_arming_state" />
          </Sequence>
        </SafetyGate>
      </Sequence>
      <RequestRecovery timeout_s="15" />
    </RecoverThenFail>
  </BehaviorTree>
</root>
