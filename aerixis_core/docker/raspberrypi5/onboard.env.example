# Settings for one aircraft. Copy to onboard.env and edit the identity.
# Everything else is set from the onboard control panel: http://<pi-address>:8090 (any browser
# on the drone's network; PIN: docker compose exec onboard /entrypoint.sh token). The values shown
# commented below are the defaults. Uncommenting an AS2_* line fixes that setting here instead —
# the panel then shows it read-only. After editing this file: docker compose up -d --force-recreate
#AS2_WEB_PORT=8090              # onboard control panel port (0 = no panel)
#AS2_PANEL_PIN=change-me          # panel PIN used when the panel first starts (change it later on the Drone page)

# --- identity: unique per aircraft; the GCS adds it with the same drone ID + system ID
AS2_DRONE_ID=drone0
AS2_SYSTEM_ID=1                 # = PX4 MAV_SYS_ID of this aircraft

# --- flight controller (PX4 uXRCE-DDS on TELEM2 -> Pi UART)
#AS2_FC_MODE=serial              # serial | udp (udp = PX4 SITL on the same computer)
#AS2_FC_DEVICE=/dev/ttyAMA0      # Pi 5: enable with dtparam=uart0=on (see README)
#AS2_FC_BAUD=921600              # must equal PX4 UXRCE_DDS_BAUD / SER_TEL2_BAUD
#AS2_FC_HEALTH_URL=/dev/ttyACM0  # FC USB: read-only health tap (compass/sensor faults, PX4 warnings); empty = off

# --- long-range telemetry radio to the laptop GCS (MAVLink)
#AS2_GCS_MODE=serial             # serial | udp
#AS2_GCS_DEVICE=/dev/ttyUSB0     # tip: use /dev/serial/by-id/... so ports never swap
#AS2_GCS_BAUD=57600              # same on both radios and in the GCS Connect page
#AS2_GCS_HOST=192.168.1.100     # udp mode: laptop IP
#AS2_GCS_PORT=14551             # udp mode: GCS listen port

# --- drone-to-drone mesh (never the GCS). Leave the passphrase empty for a single aircraft.
#AS2_MESH_MODE=both              # both (base station main + LoRa fallback, default) | udp (base station / IP mesh only) | serial (LoRa only)
#AS2_MESH_DEVICE=/dev/ttyUSB1
#AS2_MESH_BAUD=57600
#AS2_MESH_NAMES=drone0,drone1,drone2   # every aircraft in the fleet, same list on all
#AS2_MESH_PASSPHRASE=                  # 8+ characters, identical on every aircraft
#AS2_MESH_PEERS_IP=192.168.1.255      # both/udp: base-station subnet broadcast or peer IPs
#AS2_MESH_PORT=24800   # keep below 32768 (Linux picks random outgoing ports above it)

# --- A8 mini camera / tracker
#AS2_CAMERA_MODE=preview         # off | preview (detect, gimbal not moved) | track (gimbal follows)
#AS2_CAMERA_IP=192.168.144.25
#AS2_VISION_CORES=2 3

# --- safety switches (all OFF until the aircraft has been bench- and tether-tested)
#AS2_ALLOW_FLIGHT=false          # true: missions may arm and fly
#AS2_PATH_CLEAR=false            # operator confirms launch/transit paths are clear
#AS2_OPERATOR_PAYLOAD=false      # payload loaded is confirmed by the operator in the GCS
#AS2_OVERHEAD_VERIFIED=false     # overhead drop envelope verified for this airframe
#AS2_DROP_MIN_AGL=8
#AS2_DROP_MAX_AGL=20
#AS2_AUX_SET=0                   # PX4 AUX output for the release servo (1-6), 0 = no payload
#AS2_AUX_VALUE=1.0
#AS2_SEPARATION_M=10

# --- ROS 2: keep DDS inside this Pi. Aircraft talk to each other only over the mesh bridge,
# never by DDS over a shared Wi-Fi (that floods the radio and mixes fleets).
ROS_DOMAIN_ID=0
ROS_LOCALHOST_ONLY=1
